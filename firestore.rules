rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return signedIn() && request.auth.token.get('email_verified',false) == true && request.auth.token.get('admin',false) == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'Active'; }
  function active(uid) { return !exists(/databases/$(database)/documents/users/$(uid)) || get(/databases/$(database)/documents/users/$(uid)).data.status == 'Active'; }
  function shortText(value,maximum) { return value is string && value.size() <= maximum; }
  match /users/{uid} {
   allow get: if owner(uid) || admin();
   allow list: if admin();
   allow create: if owner(uid)
    && request.resource.data.keys().hasOnly(['uid','id','name','email','phone','status','createdAt','updatedAt'])
    && request.resource.data.uid == uid && request.resource.data.id == uid
    && request.resource.data.email == request.auth.token.email
    && shortText(request.resource.data.name,100) && shortText(request.resource.data.phone,24)
    && request.resource.data.status == 'Active'
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
   allow update, delete: if false;
  }
  match /admins/{uid} { allow read: if admin(); allow write: if false; }
  match /products/{id} { allow read: if admin() || (resource.data.status == 'Active' && resource.data.get('approved',false) == true); allow write: if false; }
  match /phoneModels/{id} { allow read: if admin() || resource.data.status == 'Active'; allow write: if false; }
  match /jobs/{id} { allow read: if admin() || resource.data.status == 'Published'; allow write: if false; }
  match /orders/{id} { allow read: if admin() || (signedIn() && active(request.auth.uid) && resource.data.customerId == request.auth.uid); allow write: if false; }
  match /tickets/{id} { allow read: if admin() || (signedIn() && active(request.auth.uid) && resource.data.customerId == request.auth.uid); allow write: if false; }
  match /phoneModelRequests/{id} { allow read: if admin() || (signedIn() && active(request.auth.uid) && resource.data.customerId == request.auth.uid); allow write: if false; }
  match /applications/{id} { allow read: if admin() || (signedIn() && active(request.auth.uid) && resource.data.customerId == request.auth.uid); allow write: if false; }
  match /subscribers/{uid} { allow read: if admin() || owner(uid); allow write: if false; }
  match /carts/{uid} {
   allow read: if owner(uid) && active(uid);
   allow create, update: if owner(uid) && active(uid)
    && request.resource.data.keys().hasOnly(['uid','items','updatedAt'])
    && request.resource.data.uid == uid && request.resource.data.items is list
    && request.resource.data.items.size() <= 25 && request.resource.data.updatedAt == request.time;
   allow delete: if owner(uid) && active(uid);
  }
  match /designs/{uid} {
   allow read: if owner(uid) && active(uid);
   allow create, update: if owner(uid) && active(uid)
    && request.resource.data.keys().hasOnly(['uid','draft','originalsStored','updatedAt'])
    && request.resource.data.uid == uid && request.resource.data.draft is map
    && request.resource.data.originalsStored == false && request.resource.data.updatedAt == request.time;
   allow delete: if owner(uid) && active(uid);
  }
  // Payment verification, audit logs, quotas and original artwork are never client-writable.
  match /{document=**} { allow read, write: if false; }
 }
}
