# Save real values in Vercel's protected Production environment, never in Git.
RAZORPAY_KEY_ID=rzp_test_your_public_id
RAZORPAY_KEY_SECRET=replace_in_vercel_only
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Legacy owner configuration: a Sensitive variable named exactly as the public
# rzp_test_ Key ID is accepted on the server when RAZORPAY_KEY_SECRET is absent.
# Live mode and rzp_live_ keys are rejected. Only Admin Head can run sandbox tests.
